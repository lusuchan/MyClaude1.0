# Copy to .env and fill in. .env is gitignored.

# Required for the research + synthesis steps.
ANTHROPIC_API_KEY=your-key-here

# Optional overrides -----------------------------------------------------

# Model used for research (web search) and synthesis.
# BRIEF_MODEL=claude-sonnet-5

# Max web searches Claude may run per research call.
# BRIEF_MAX_SEARCHES=6

# Where briefs are written.
# BRIEF_OUTPUT_DIR=briefs

# yfinance browser impersonation profile passed to curl_cffi. Only needed if
# your network sits behind a TLS-inspecting proxy that resets Chrome's TLS
# fingerprint. "safari" is a good fallback. Leave unset for normal networks.
# YF_IMPERSONATE=safari
